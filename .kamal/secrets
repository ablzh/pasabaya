# Rails credentials are the source of truth. This file maps them to the names
# expected by Kamal and accessory containers; never put literal secrets here.
KAMAL_REGISTRY_PASSWORD=$(bin/rails credentials:fetch kamal.registry_password)
NETDATA_CLAIM_TOKEN=$(bin/rails credentials:fetch netdata.claim_token)
NETDATA_CLAIM_ROOMS=$(bin/rails credentials:fetch netdata.claim_rooms)
AWS_ENDPOINT=$(bin/rails credentials:fetch r2.endpoint)
AWS_ACCESS_KEY_ID=$(bin/rails credentials:fetch r2.access_key_id)
AWS_SECRET_ACCESS_KEY=$(bin/rails credentials:fetch r2.secret_access_key)
RESTIC_REPOSITORY="s3:$(bin/rails credentials:fetch r2.endpoint)/pasabaya-backups/restic"
RESTIC_PASSWORD=$(bin/rails credentials:fetch restic.password)
RAILS_MASTER_KEY=$(ruby -e 'print ENV["RAILS_MASTER_KEY"].to_s.empty? ? File.read("config/master.key").strip : ENV["RAILS_MASTER_KEY"]')
