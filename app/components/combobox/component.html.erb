<div class="w-full">
  <%= select_tag @name,
      grouped_options_for_select(@grouped_options, @selected),
      id: @id,
      include_blank: @placeholder,
      class: "w-full",
      data: {
        controller: "select",
        action: "turbo:before-render@document->select#teardown turbo:render@document->select#connect turbo:before-cache@document->select#teardown"
      } %>
</div>
