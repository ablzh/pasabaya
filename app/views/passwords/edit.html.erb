<div class="mx-auto md:w-2/3 w-full">


  <h1 class="font-bold text-4xl">Update your password</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
    <%= render Forms::ErrorSummary::Component.new(record: @user, form: form, title: "Your password wasn’t reset. Check the highlighted fields.") %>
    <% if @user.errors.any? %>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">Re-enter both password fields before submitting again.</p>
    <% end %>
    <%= render(Forms::Component.new(
      label: "New Password",
      name: :password,
      id: form.field_id(:password),
      error: form_error(@user, :password)
    )) do |field| %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: "block w-full rounded-xl border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 shadow-sm px-4 py-3", **field.input_attributes %>
    <% end %>

    <%= render(Forms::Component.new(
      label: "Confirm Password",
      name: :password_confirmation,
      id: form.field_id(:password_confirmation),
      error: form_error(@user, :password_confirmation)
    )) do |field| %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: "block w-full rounded-xl border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 shadow-sm px-4 py-3", **field.input_attributes %>
    <% end %>

    <div class="pt-2">
      <%= form.submit "Save", class: "w-full sm:w-auto text-center rounded-xl px-5 py-3 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer shadow-sm transition-all text-sm" %>
    </div>
  <% end %>
</div>
