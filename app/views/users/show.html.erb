<div class="max-w-4xl mx-auto px-4 py-8 space-y-12">

  <%# 1. Profile Header Card %>
  <%= render(Card::Component.new(rounded: :"3xl", padding: :lg)) do %>
    <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
      <%= user_avatar(@user, classes: "w-32 h-32 text-3xl shrink-0") %>
      <div class="flex-1 space-y-2">
        <h1 class="text-3xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
          <%= @user.first_name %> <%= @user.last_name %>
        </h1>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          Member since <%= @user.created_at.strftime("%B %Y") %>
        </p>

        <div class="flex flex-wrap gap-2 items-center justify-center sm:justify-start pt-1">
          <% @user.verified_communities.each do |comm| %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
              <%= comm.name %>
            </span>
          <% end %>
          <% if @user.female? %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-pink-100 text-pink-800 dark:bg-pink-950/60 dark:text-pink-300 border border-pink-300 dark:border-pink-800">
              Female Profile
            </span>
          <% end %>
        </div>

        <%# Button Actions (Facebook Profile + Conditional Edit Profile) %>
        <div class="mt-4 flex flex-wrap gap-3 justify-center sm:justify-start">
          <% if @user.facebook_profile_url.present? %>
            <%= render Buttons::Component.new(
                       text: "View Facebook Profile",
                       href: @user.facebook_profile_url,
                       variant: :primary,
                       size: :sm,
                       target: "_blank") %>
          <% end %>

          <% if Current.user == @user %>
            <%= render Buttons::Component.new(
                       text: "Edit Profile",
                       href: settings_profile_path,
                       variant: :outline,
                       size: :sm) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# 2. Listings Section %>
  <div>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-neutral-900 dark:text-white tracking-tight">Active Posts</h2>
      <span class="text-xs font-bold text-neutral-400 uppercase tracking-widest"><%= @ride_posts.count %> listings</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% if @ride_posts.any? %>
        <%= render @ride_posts %>
      <% else %>
        <div class="col-span-full py-12 text-center text-neutral-500 bg-neutral-50 dark:bg-neutral-800/50 rounded-2xl border border-dashed border-neutral-200 dark:border-neutral-700">
          No active ride offers or requests listed at the moment.
        </div>
      <% end %>
    </div>
  </div>

</div>
