<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl text-neutral-900 dark:text-white mb-8 text-center">Create Your Account</h1>

  <%= render(Card::Component.new(rounded: :"3xl", padding: :lg)) do %>
    <%= form_with model: @user, url: sign_up_path, class: "space-y-6" do |form| %>
      <div class="hidden" aria-hidden="true">
        <%= form.invisible_captcha :contact_reference %>
      </div>

      <%= render Forms::ErrorSummary::Component.new(record: @user, form: form,
        title: "Your account wasn’t created. Check the highlighted fields.") %>

      <div class="grid grid-cols-2 gap-4">
        <%= render(Forms::Component.new(
          label: "First Name",
          name: :first_name,
          id: form.field_id(:first_name),
          required: true,
          error: form_error(@user, :first_name)
        )) do |field| %>
          <%= form.text_field :first_name, required: true, class: "w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
        <% end %>

        <%= render(Forms::Component.new(
          label: "Last Name",
          name: :last_name,
          id: form.field_id(:last_name),
          required: true,
          error: form_error(@user, :last_name)
        )) do |field| %>
          <%= form.text_field :last_name, required: true, class: "w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
        <% end %>
      </div>

      <%= render(Forms::Component.new(
        label: "Facebook Profile URL",
        name: :facebook_profile_url,
        id: form.field_id(:facebook_profile_url),
        required: false,
        helper_text: "Optional. Add a link to your Facebook profile to help others recognize you. This does not verify identity.",
        error: form_error(@user, :facebook_profile_url)
      )) do |field| %>
        <%= form.url_field :facebook_profile_url, placeholder: "https://facebook.com/username", class: "w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
      <% end %>

      <%= render(Forms::Component.new(
        label: "Email Address",
        name: :email_address,
        id: form.field_id(:email_address),
        required: true,
        error: form_error(@user, :email_address)
      )) do |field| %>
        <%= form.email_field :email_address, required: true, class: "w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
      <% end %>

      <%= render(Forms::Component.new(
        label: "Password",
        name: :password,
        id: form.field_id(:password),
        required: true,
        error: form_error(@user, :password)
      )) do |field| %>
        <%= form.password_field :password, required: true, class: "w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
      <% end %>

      <%= render(Forms::Component.new(
        label: "Confirm Password",
        name: :password_confirmation,
        id: form.field_id(:password_confirmation),
        required: true,
        error: form_error(@user, :password_confirmation)
      )) do |field| %>
        <%= form.password_field :password_confirmation, required: true, class: "w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
      <% end %>


      <%= render(Forms::Component.new(id: form.field_id(:registration_acceptance), error: form_error(@user, :registration_acceptance))) do |field| %>
      <div class="flex items-start gap-3">
        <%= form.check_box :registration_acceptance, required: true, class: "mt-1 rounded border-neutral-300 text-blue-600 focus:ring-blue-500", **field.input_attributes %>
        <%= form.label :registration_acceptance, class: "text-sm text-neutral-700 dark:text-neutral-300" do %>
          I confirm that I am at least 18 years old and agree to the
          <%= link_to "Terms of Service", terms_path, class: "text-blue-600 dark:text-blue-400 hover:underline font-semibold" %>
          and
          <%= link_to "Privacy Policy", privacy_path, class: "text-blue-600 dark:text-blue-400 hover:underline font-semibold" %>
        <% end %>
      </div>
      <% end %>

      <div class="pt-4">
        <%= render Buttons::Component.new(text: "Create Account & Log In", type: "submit", size: :lg, full_width: true) %>
      </div>
    <% end %>
  <% end %>

  <p class="text-center text-sm text-neutral-500 dark:text-neutral-400 mt-6">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "text-blue-600 dark:text-blue-400 hover:underline font-semibold" %>
  </p>
</div>
