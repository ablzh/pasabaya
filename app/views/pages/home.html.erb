<% set_meta_tags title: "Carpooling Philippines", reverse: false %>
<div class="flex flex-col items-center lg:px-8 font-sans">


  <div class="max-w-5xl w-full sm:px-6 lg:px-8">
    <%# 1. Hero Section %>
    <header class="text-center space-y-8 mb-16 mt-8">
      <span class="inline-block py-1.5 text-xs font-bold tracking-widest text-indigo-700 uppercase bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-300 rounded-full">
        Community Ride Board
      </span>
      <h1 class="text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight sm:text-5xl md:text-7xl leading-tight">
        Carpooling for the Community, <br class="hidden lg:block">
        <span class="text-indigo-600 dark:text-indigo-400">Not for Profit.</span>
      </h1>
      <p class="max-w-2xl mx-auto text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed">
        A smarter, social way to find travel companions in the Philippines. No fees. No commissions. Just people helping
        people beat the traffic.
      </p>

      <div class="max-w-4xl mx-auto pt-8">
        <%= render "ride_posts/search_form" %>
      </div>

      <% if @popular_routes.present? && @popular_routes.any? %>
        <div class="max-w-4xl mx-auto text-left">
          <div class="bg-neutral-50 dark:bg-neutral-900/50 rounded-3xl p-6 sm:p-8 border border-neutral-100 dark:border-white/5">
            <h2 class="text-lg font-bold text-neutral-900 dark:text-white mb-4 flex items-center gap-2">
              <svg class="size-5 text-indigo-600 dark:text-indigo-400 shrink-0" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5C15 12.1569 13.6569 13.5 12 13.5C10.3431 13.5 9 12.1569 9 10.5C9 8.84315 10.3431 7.5 12 7.5C13.6569 7.5 15 8.84315 15 10.5Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5C19.5 17.6421 12 21.75 12 21.75C12 21.75 4.5 17.6421 4.5 10.5C4.5 6.35786 7.85786 3 12 3C16.1421 3 19.5 6.35786 19.5 10.5Z" />
              </svg>
              Active Carpool Routes
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              <% @popular_routes.each do |route| %>
                <%= link_to route_rides_path(origin_slug: route[:origin].slug, destination_slug: route[:destination].slug),
                            class: "flex items-center justify-between p-3.5 bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-100 dark:border-white/5 hover:border-indigo-500 dark:hover:border-indigo-500/50 hover:shadow-md transition group" do %>
                  <div class="flex flex-col">
                    <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                      <%= route[:origin].name %> → <%= route[:destination].name %>
                    </span>
                    <span class="text-xs text-neutral-400 mt-0.5">
                      <%= pluralize(route[:count], "active listing") %>
                    </span>
                  </div>
                  <span class="text-neutral-400 group-hover:translate-x-1 transition-transform text-sm">→</span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </header>

    <%# Video Section %>
    <section class="max-w-4xl mx-auto mb-24">
      <div class="aspect-video rounded-3xl overflow-hidden shadow-2xl border border-neutral-200 dark:border-neutral-800">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/zZxOvbtzMhE?si=tmHwyexQ-a-NNaq7" 
          title="YouTube video player" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen>
        </iframe>
      </div>
    </section>

    <%# 2. The Problem %>
    <section class="max-w-3xl mx-auto mb-24">
      <%= render(Card::Component.new(rounded: :"3xl", padding: :lg)) do %>
        <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">Why Pasabaya.app?</h2>
        <div class="space-y-6 text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
          <p>
            Traffic in the Philippines is a shared struggle. Public transport can be inconvenient for daily commutes of
            tens of kilometers, and while Facebook groups or Reddit threads help people find rides, they aren't built
            for it.
          </p>
          <p>With the recent declaration of an <strong>energy emergency</strong>, there is a clear need for us to be
            more efficient and travel together. Pasabaya.app is just an organized tool to help you find someone
            heading your way.</p>
          <p class="font-medium text-indigo-600 dark:text-indigo-400 text-xl border-l-4 border-indigo-200 dark:border-indigo-900/50 pl-6 mt-8">
            We took the "pasabay" culture you already know and gave it a better interface.
          </p>
        </div>
      <% end %>
    </section>

    <%# 3. How it Works %>
    <section class="mb-24">
      <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-12 text-center max-w-2xl mx-auto">
        It’s Social Networking, <br class="hidden sm:block">
        Not a Transport Company.
      </h2>
      <div class="grid gap-8 md:grid-cols-3">
        <%= render(Card::Component.new(rounded: :"3xl", padding: :lg, hoverable: true)) do %>
          <div class="w-14 h-14 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center mb-6">
            <svg class="size-8" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75C7.71719 18.75 13.0136 19.4812 18.0468 20.8512C18.7738 21.0491 19.5 20.5086 19.5 19.7551V18.75M3.75 4.5V5.25C3.75 5.66421 3.41421 6 3 6H2.25M2.25 6V5.625C2.25 5.00368 2.75368 4.5 3.375 4.5H20.25M2.25 6V15M20.25 4.5V5.25C20.25 5.66421 20.5858 6 21 6H21.75M20.25 4.5H20.625C21.2463 4.5 21.75 5.00368 21.75 5.625V15.375C21.75 15.9963 21.2463 16.5 20.625 16.5H20.25M21.75 15H21C20.5858 15 20.25 15.3358 20.25 15.75V16.5M20.25 16.5H3.75M3.75 16.5H3.375C2.75368 16.5 2.25 15.9963 2.25 15.375V15M3.75 16.5V15.75C3.75 15.3358 3.41421 15 3 15H2.25M15 10.5C15 12.1569 13.6569 13.5 12 13.5C10.3431 13.5 9 12.1569 9 10.5C9 8.84315 10.3431 7.5 12 7.5C13.6569 7.5 15 8.84315 15 10.5ZM18 10.5H18.0075V10.5075H18V10.5ZM6 10.5H6.0075V10.5075H6V10.5Z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Zero Payments</h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            We don't handle money. No booking fees, no commissions, no hidden costs.
          </p>
        <% end %>

        <%= render(Card::Component.new(rounded: :"3xl", padding: :lg, hoverable: true)) do %>
          <div class="w-14 h-14 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center mb-6">
            <svg class="size-8" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.7498L11.25 14.9998L15 9.74985M12 2.71411C9.8495 4.75073 6.94563 5.99986 3.75 5.99986C3.69922 5.99986 3.64852 5.99955 3.59789 5.99892C3.2099 7.17903 3 8.43995 3 9.74991C3 15.3414 6.82432 20.0397 12 21.3719C17.1757 20.0397 21 15.3414 21 9.74991C21 8.43995 20.7901 7.17903 20.4021 5.99892C20.3515 5.99955 20.3008 5.99986 20.25 5.99986C17.0544 5.99986 14.1505 4.75073 12 2.71411Z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Facebook-Verified</h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Connect with real people. Check profiles and mutual friends before you decide to ride together.
          </p>
        <% end %>

        <%= render(Card::Component.new(rounded: :"3xl", padding: :lg, hoverable: true)) do %>
          <div class="w-14 h-14 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center mb-6">
            <svg class="size-8" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.0423 21.6718L13.6835 16.6007M13.6835 16.6007L11.1741 18.826L11.7425 9.35623L16.9697 17.2731L13.6835 16.6007ZM12 2.25V4.5M17.8336 4.66637L16.2426 6.25736M20.25 10.5H18M7.75736 14.7426L6.16637 16.3336M6 10.5H3.75M7.75736 6.25736L6.16637 4.66637" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-4">Simple Matching</h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            No complex dispatching. Just a digital bulletin board with smart filters to find someone heading your way.
          </p>
        <% end %>
      </div>
    </section>

    <%# 4. About the Creator %>
    <section class="max-w-3xl mx-auto mb-24">
      <div class="bg-neutral-900 dark:bg-black rounded-3xl p-6 sm:p-14 shadow-2xl text-white relative overflow-hidden border border-white/5">
        <!-- Abstract shape decoration -->
        <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-indigo-600 opacity-20 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 rounded-full bg-blue-500 opacity-20 blur-3xl"></div>
        <div class="relative z-10">
          <h2 class="text-3xl font-bold mb-8 text-indigo-300">From a Student, For the People</h2>
          <div class="space-y-6 text-lg text-neutral-300 leading-relaxed">
            <p>
              Hi, I’m <span class="text-white font-semibold">Artem Blazhievskii</span>, an MIS student at the University
              of the Philippines Open University.
            </p>
            <p>
              I’m building <span class="text-white font-semibold">Pasabaya.app</span> as an open-source volunteer
              project to help solve a problem we all face. I am not a transport company; I am just a developer who
              believes that technology should make our daily lives easier and more human.
            </p>
          </div>
        </div>
      </div>
    </section>

    <%# 5. Safety & Trust Section %>
    <section id="safety" class="max-w-4xl mx-auto mb-24">
      <div class="bg-amber-50 dark:bg-amber-950/20 rounded-3xl p-6 sm:p-14 border border-amber-100 dark:border-amber-900/30 shadow-sm">
        <div class="flex flex-col md:flex-row gap-10">
          <div class="flex-1">
            <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6 flex items-center gap-3">
              <svg class="size-8 text-amber-600 dark:text-amber-400 shrink-0" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.7498L11.25 14.9998L15 9.74985M12 2.71411C9.8495 4.75073 6.94563 5.99986 3.75 5.99986C3.69922 5.99986 3.64852 5.99955 3.59789 5.99892C3.2099 7.17903 3 8.43995 3 9.74991C3 15.3414 6.82432 20.0397 12 21.3719C17.1757 20.0397 21 15.3414 21 9.74991C21 8.43995 20.7901 7.17903 20.4021 5.99892C20.3515 5.99955 20.3008 5.99986 20.25 5.99986C17.0544 5.99986 14.1505 4.75073 12 2.71411Z" />
              </svg>
              Safety First
            </h2>
            <div class="space-y-4 text-neutral-700 dark:text-neutral-300 leading-relaxed">
              <p>
                Pasabaya.app is a <strong>public bulletin board</strong>. We provide the tools to find matches, but the
                actual coordination happens between you and the other person on Facebook.
              </p>
              <p class="font-medium text-amber-800 dark:text-amber-200">
                You are responsible for your own safety. Always verify who you are traveling with.
              </p>
              <div class="pt-4 flex gap-3">
                <%= render Buttons::Component.new(
                      text: "Safety & Terms", 
                      href: terms_path, 
                      variant: :outline, 
                      size: :sm) %>
                <%= render Buttons::Component.new(
                      text: "Privacy", 
                      href: privacy_path, 
                      variant: :ghost, 
                      size: :sm) %>
              </div>
            </div>
          </div>
          <div class="flex-1 bg-white/50 dark:bg-neutral-800/50 rounded-2xl p-8 border border-amber-200/50 dark:border-amber-900/30">
            <h3 class="font-bold text-neutral-900 dark:text-white mb-4 uppercase tracking-wider text-sm">Trust Checklist</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="size-5 text-green-600 dark:text-green-400 shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.7045 4.15347C17.034 4.4045 17.0976 4.87509 16.8466 5.20457L8.84657 15.7046C8.71541 15.8767 8.51627 15.9838 8.30033 15.9983C8.08439 16.0129 7.87271 15.9334 7.71967 15.7804L3.21967 11.2804C2.92678 10.9875 2.92678 10.5126 3.21967 10.2197C3.51256 9.92682 3.98744 9.92682 4.28033 10.2197L8.17351 14.1129L15.6534 4.29551C15.9045 3.96603 16.3751 3.90243 16.7045 4.15347Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-neutral-700 dark:text-neutral-300">Check their Facebook profile age and activity.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="size-5 text-green-600 dark:text-green-400 shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.7045 4.15347C17.034 4.4045 17.0976 4.87509 16.8466 5.20457L8.84657 15.7046C8.71541 15.8767 8.51627 15.9838 8.30033 15.9983C8.08439 16.0129 7.87271 15.9334 7.71967 15.7804L3.21967 11.2804C2.92678 10.9875 2.92678 10.5126 3.21967 10.2197C3.51256 9.92682 3.98744 9.92682 4.28033 10.2197L8.17351 14.1129L15.6534 4.29551C15.9045 3.96603 16.3751 3.90243 16.7045 4.15347Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-neutral-700 dark:text-neutral-300">Look for mutual friends or common groups.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="size-5 text-green-600 dark:text-green-400 shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.7045 4.15347C17.034 4.4045 17.0976 4.87509 16.8466 5.20457L8.84657 15.7046C8.71541 15.8767 8.51627 15.9838 8.30033 15.9983C8.08439 16.0129 7.87271 15.9334 7.71967 15.7804L3.21967 11.2804C2.92678 10.9875 2.92678 10.5126 3.21967 10.2197C3.51256 9.92682 3.98744 9.92682 4.28033 10.2197L8.17351 14.1129L15.6534 4.29551C15.9045 3.96603 16.3751 3.90243 16.7045 4.15347Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-neutral-700 dark:text-neutral-300"><strong>Never pay in advance.</strong> Coordination is free.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="size-5 text-green-600 dark:text-green-400 shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.7045 4.15347C17.034 4.4045 17.0976 4.87509 16.8466 5.20457L8.84657 15.7046C8.71541 15.8767 8.51627 15.9838 8.30033 15.9983C8.08439 16.0129 7.87271 15.9334 7.71967 15.7804L3.21967 11.2804C2.92678 10.9875 2.92678 10.5126 3.21967 10.2197C3.51256 9.92682 3.98744 9.92682 4.28033 10.2197L8.17351 14.1129L15.6534 4.29551C15.9045 3.96603 16.3751 3.90243 16.7045 4.15347Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-neutral-700 dark:text-neutral-300">Share your location with family/friends during the ride.</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="size-5 text-green-600 dark:text-green-400 shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.7045 4.15347C17.034 4.4045 17.0976 4.87509 16.8466 5.20457L8.84657 15.7046C8.71541 15.8767 8.51627 15.9838 8.30033 15.9983C8.08439 16.0129 7.87271 15.9334 7.71967 15.7804L3.21967 11.2804C2.92678 10.9875 2.92678 10.5126 3.21967 10.2197C3.51256 9.92682 3.98744 9.92682 4.28033 10.2197L8.17351 14.1129L15.6534 4.29551C15.9045 3.96603 16.3751 3.90243 16.7045 4.15347Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm text-neutral-700 dark:text-neutral-300">Meet in well-lit, public locations for pickup.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <%# 6. Final Call to Action %>
    <section class="max-w-xl mx-auto text-center space-y-10 mb-16">
      <div class="space-y-4">
        <h3 class="text-3xl font-bold text-neutral-900 dark:text-white">Ready to find a ride?</h3>
        <p class="text-lg text-neutral-500 dark:text-neutral-400">Join the community and start saving on your commute today.</p>
      </div>
      <div class="flex justify-center">
        <%= render Buttons::Component.new(
              text: "Browse All Rides", 
              href: ride_posts_path(post_type: "", origin_id: "", destination_id: ""),
              variant: :primary, 
              size: :lg, 
              style: :fancy,
              pill: true) %>
      </div>
      <p class="text-sm text-neutral-400 dark:text-neutral-500 font-medium italic">
        * By using this site, you agree that Pasabaya.app is not liable for any incidents arising from external coordination.
      </p>

      <div>
        <%= link_to root_path, class: "inline-block align-middle h-[1.15em] w-[1.15em] ml-[0.2em]
  object-contain" do %>
          <%= image_tag "logo.svg", size: "72x72", alt: "Pasabaya Logo" %>
        <% end %>
      </div>

    </section>
  </div>
</div>
