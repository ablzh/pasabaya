<% content_for :title, "Chats" %>
<%= turbo_stream_from [Current.user, :chats] %>
<div class="max-w-2xl mx-auto my-8 px-4 sm:px-0">
  <h1 class="text-2xl font-bold text-neutral-900 dark:text-white mb-6">Chats</h1>
  <% if @rides.empty? %>
    <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 p-8 text-center">
      <p class="text-neutral-600 dark:text-neutral-400">No trip conversations yet. Chats appear when you drive or join a confirmed trip.</p>
      <%= link_to "Find a ride", ride_posts_path, class: "inline-block mt-4 text-blue-600 dark:text-blue-400 font-semibold hover:underline" %>
    </div>
  <% end %>
  <div class="divide-y divide-neutral-100 dark:divide-neutral-800 rounded-3xl border border-neutral-200 dark:border-neutral-800 overflow-hidden">
    <% @rides.each do |ride| %>
      <% message = @latest_messages[ride.id] %>
      <%= link_to ride_post_path(ride, tab: "chat"), class: "block p-5 hover:bg-neutral-50 dark:hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-blue-600" do %>
        <h2 class="font-semibold text-neutral-900 dark:text-white"><%= ride.origin.name %> → <%= ride.destination.name %></h2>
        <span class="inline-block mt-1 text-xs text-neutral-600 dark:text-neutral-400"><%= ride.chat_writable? ? "Open for messages" : (ride.chat_unlocked? ? "Read-only" : "Waiting for confirmed passengers") %></span>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2"><%= message&.body&.truncate(110) || "No messages yet. Coordinate your trip here." %></p>
        <% timestamp = message&.created_at || ride.created_at %>
        <time datetime="<%= timestamp.iso8601 %>" class="block text-xs text-neutral-500 mt-2"><%= timestamp.in_time_zone("Asia/Manila").strftime("%b %d, %Y at %I:%M %p") %> Philippine time (UTC+8)</time>
      <% end %>
    <% end %>
  </div>
</div>
