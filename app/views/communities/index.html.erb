<div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
  <div class="text-center max-w-2xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300">
      <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
      Verified Closed Hubs
    </div>
    <h1 class="text-3xl font-extrabold text-neutral-900 dark:text-white tracking-tight">Community Carpool Hubs</h1>
    <p class="text-sm text-neutral-600 dark:text-neutral-400">
      Verify your institutional email to carpool with confirmed members of your campus community.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% @communities.each do |community| %>
      <% membership = @my_memberships[community.id] %>
      <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-start justify-between gap-3 mb-2">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full <%= community.company? ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300' %>">
                <%= community.hub_type.titleize %>
              </span>
              <h2 class="text-lg font-bold text-neutral-900 dark:text-white mt-1">
                <%= link_to community.name, community_path(community), class: "hover:underline" %>
              </h2>
            </div>
            <% if membership&.verified? %>
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 shrink-0">
                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                Verified
              </span>
            <% end %>
          </div>

          <p class="text-xs text-neutral-500">Domain: <code class="font-mono text-neutral-700 dark:text-neutral-300">@<%= community.domain %></code></p>
          <p class="text-xs text-neutral-500 mt-1"><%= pluralize(@member_counts[community.id] || 0, "verified member") %></p>
        </div>

        <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between">
          <%= link_to "View Hub Rides", community_path(community), class: "text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline" %>

          <% if membership&.verified? %>
            <span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">Member</span>
          <% elsif membership&.pending_verification? %>
            <span class="text-xs text-amber-600 dark:text-amber-400 font-medium">Verification Pending</span>
          <% else %>
            <%= link_to "Join Hub", community_path(community), class: "px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:opacity-90 transition-opacity" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm text-center space-y-3">
    <h2 class="text-base font-bold text-neutral-900 dark:text-white">Request a Community Hub</h2>
    <p class="text-xs text-neutral-600 dark:text-neutral-400 max-w-md mx-auto">
      Want a dedicated hub for your university or institution? Message us on Facebook with your institution name and official email domain to request a new community hub.
    </p>
    <div>
      <%= link_to "Request a Community Hub", "https://www.facebook.com/people/Pasabayaapp-Carpooling-for-the-Community/61589209230043/", target: "_blank", rel: "noopener noreferrer", class: "btn-primary inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold shadow-sm" %>
    </div>
  </div>

  <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-900/40 border border-neutral-200 dark:border-neutral-800 text-center">
    <p class="text-xs text-neutral-500 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
      Pasabaya is an independent community platform and is not officially affiliated with, endorsed by, or partnered with any listed university or institution. Hubs are community-led spaces verified via institutional email domains.
    </p>
  </div>
</div>
