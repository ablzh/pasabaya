<div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
  <%# Community Header %>
  <div class="p-6 sm:p-8 rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <%= render Badge::Component.new(text: "#{@community.hub_type.titleize} Hub", variant: (@community.company? ? :orange : :green), size: :md, pill: true, uppercase: true) %>
        <h1 class="text-3xl font-extrabold text-neutral-900 dark:text-white mt-2 tracking-tight">
          <%= @community.name %>
        </h1>
        <p class="text-sm text-neutral-500 mt-1">
          Requires verified email ending with <strong class="text-neutral-800 dark:text-neutral-200">@<%= @community.domain %></strong> &bull; <%= pluralize(@community.verified_members_count, "verified member") %>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to "All Hubs", communities_path, class: "px-4 py-2 rounded-xl text-xs font-semibold border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors" %>
        <% if @membership&.verified? %>
          <%= link_to "Post Hub Ride", new_ride_post_path(community_id: @community.id), class: "px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors" %>
        <% end %>
      </div>
    </div>

    <%# Membership verification section %>
    <div class="border-t border-neutral-100 dark:border-neutral-800 pt-4">
      <% if authenticated? %>
        <% if @membership&.verified? %>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 gap-3">
            <div class="flex items-center gap-3">
              <span class="p-2 rounded-xl bg-emerald-600 text-white shrink-0">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
              </span>
              <div>
                <p class="text-sm font-bold text-emerald-900 dark:text-emerald-200">Verified Member</p>
                <p class="text-xs text-emerald-700 dark:text-emerald-400">Verified institutional mailbox: <%= @membership.institutional_email %></p>
              </div>
            </div>
            <%= button_to "Leave Hub", community_membership_path(@community, @membership), method: :delete, data: { turbo_confirm: "Leaving this hub will cancel any upcoming hub rides or seat bookings. Proceed?" }, class: "px-3 py-1.5 rounded-lg text-xs font-semibold text-red-600 hover:bg-red-100/50 dark:hover:bg-red-950/30 transition-colors self-end sm:self-auto" %>
          </div>
        <% elsif @membership&.pending_verification? %>
          <div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/40 space-y-3">
            <p class="text-sm font-bold text-amber-900 dark:text-amber-200">Verification Pending</p>
            <p class="text-xs text-amber-700 dark:text-amber-400">A magic link was sent to <strong><%= @membership.institutional_email %></strong>. Please check your inbox and click the link to confirm.</p>
            <%= form_with(url: community_memberships_path(@community), method: :post, class: "flex items-center gap-3 pt-2") do |f| %>
              <%= f.hidden_field :institutional_email, value: @membership.institutional_email %>
              <%= f.submit "Resend Verification Link", class: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-amber-600 text-white hover:bg-amber-700 cursor-pointer transition-colors" %>
            <% end %>
          </div>
        <% else %>
          <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-100 dark:border-neutral-800 space-y-3">
            <h3 class="text-sm font-bold text-neutral-900 dark:text-white">Verify Your Membership</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400">
              Enter your work or campus email ending in <strong>@<%= @community.domain %></strong>. We'll send you a one-time verification link.
            </p>
            <%= form_with(url: community_memberships_path(@community), method: :post, class: "flex flex-col sm:flex-row items-center gap-3") do |f| %>
              <%= f.email_field :institutional_email, placeholder: "yourname@#{@community.domain}", required: true, class: "w-full sm:w-80 px-4 py-2.5 rounded-xl text-sm border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white focus:ring-blue-500" %>
              <%= f.submit "Send Magic Link", class: "w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-700 cursor-pointer transition-colors" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-100 dark:border-neutral-800 flex items-center justify-between">
          <p class="text-xs text-neutral-500">Sign in to Pasabaya to verify your institutional email and access closed-hub rides.</p>
          <%= link_to "Login", new_session_path(return_to: request.path), class: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Active Rides in Hub %>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-neutral-900 dark:text-white tracking-tight">Active Hub Rides</h2>
      <span class="text-xs font-bold text-neutral-400 uppercase tracking-widest"><%= pluralize(@ride_posts.count, "ride") %></span>
    </div>

    <% if @ride_posts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render @ride_posts %>
      </div>
    <% else %>
      <div class="p-12 text-center text-neutral-500 bg-neutral-50 dark:bg-neutral-800/50 rounded-3xl border border-dashed border-neutral-200 dark:border-neutral-700 space-y-2">
        <p class="font-medium text-sm">No active rides posted in this hub yet.</p>
        <% if @membership&.verified? %>
          <p class="text-xs"><%= link_to "Be the first to offer a ride for #{@community.name}", new_ride_post_path(community_id: @community.id), class: "text-blue-600 underline font-semibold" %></p>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-neutral-900/40 border border-neutral-200 dark:border-neutral-800 text-center">
    <p class="text-xs text-neutral-500 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
      Pasabaya is an independent community platform and is not officially affiliated with, endorsed by, or partnered with any listed university or institution. Hubs are community-led spaces verified via institutional email domains.
    </p>
  </div>
</div>
