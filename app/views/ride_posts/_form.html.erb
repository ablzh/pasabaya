<% grouped_locations = local_assigns[:grouped_locations] || Location.grouped_by_region %>
<% regular = ride_post.is_a?(RideSchedule) %>
<% choose_ride_type = local_assigns.fetch(:choose_ride_type, ride_post.new_record?) %>
<% scope = choose_ride_type ? "ride_post" : ride_post.model_name.param_key %>
<% time_attribute = regular && !choose_ride_type ? :departure_clock : :exact_departure_time %>
<% departure_clock = regular ? ride_post.departure_clock : (ride_post.exact_departure_time || ride_post.departure_time&.strftime("%H:%M")) %>
<% schedule = regular ? ride_post : RideSchedule.new %>
<%= form_with(model: ride_post, scope: scope, id: dom_id(ride_post, :form), url: choose_ride_type ? ride_posts_path : polymorphic_path(ride_post), class: "w-full space-y-6",
  data: { controller: "ride-creation", ride_creation_regular_value: regular, action: "input->ride-creation#updateSummary change->ride-creation#updateSummary morph-draft:restored@document->ride-creation#restoreDraft" }) do |form| %>
  <% if choose_ride_type %>
    <fieldset class="min-w-0 space-y-3">
      <legend class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Ride type</legend>
      <div class="grid grid-cols-2 gap-2" data-ride-creation-target="typeGroup" data-action="change->ride-creation#changeType">
        <% [["one_time", "One-time"], ["regular", "Regular"]].each do |value, label| %>
          <%= render Radio::Component.new(label: label, name: "ride_type", value: value, id: "ride_type_#{value}", checked: regular == (value == "regular"),
            classes: "min-w-0 rounded-xl border border-neutral-200 dark:border-neutral-700 px-3 has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30",
            input_classes: "shrink-0 text-blue-600 accent-blue-600 focus:ring-blue-500 dark:checked:bg-blue-600", label_classes: "flex min-h-12 items-center cursor-pointer") %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <%= render Forms::ErrorSummary::Component.new(record: ride_post, form: form,
    title: params[:intent] == "publish" ? "We couldn’t publish your ride. Check the highlighted fields." : "Your ride wasn’t saved. Check the highlighted fields.",
    targets: { departure_choice: form.field_id(:departure_choice, :morning), departure_clock: form.field_id(time_attribute), weekday_ids: form.field_id(:weekday, 1), user: nil, source_ride_post_id: nil, ladies_only: Current.user&.female? ? form.field_id(:ladies_only) : nil }) %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <p class="col-span-full text-sm text-neutral-500">Offer seats as a driver. Choose when you travel and how many passenger seats you offer. You can save an incomplete ride as a private draft. All times are Philippine time (UTC+8).</p>

    <!-- Origin Location -->
    <%= render(Forms::Component.new(
      label: "Leaving from (City)",
      name: "#{form.object_name}[origin_id]",
      id: form.field_id(:origin_id),
      error: form_error(ride_post, :origin_id)
    )) do |field| %>
      <%= render Combobox::Component.new(
                 name: "#{form.object_name}[origin_id]",
                 id: form.field_id(:origin_id),
                 grouped_options: grouped_locations,
                 selected: ride_post.origin_id,
                 placeholder: "Select a city...", input_attributes: field.input_attributes) %>
    <% end %>

    <!-- Destination Location -->
    <%= render(Forms::Component.new(
      label: "Going to (City)",
      name: "#{form.object_name}[destination_id]",
      id: form.field_id(:destination_id),
      error: form_error(ride_post, :destination_id)
    )) do |field| %>
      <%= render Combobox::Component.new(
                 name: "#{form.object_name}[destination_id]",
                 id: form.field_id(:destination_id),
                 grouped_options: grouped_locations,
                 selected: ride_post.destination_id,
                 placeholder: "Select a city...", input_attributes: field.input_attributes) %>
    <% end %>

    <fieldset class="col-span-full grid min-w-0 grid-cols-1 md:grid-cols-2 gap-6" data-ride-creation-target="oneTimeFields" <%= tag.attributes(hidden: regular, disabled: regular) %>>
      <legend class="sr-only">One-time departure</legend>
      <!-- Departure Date -->
      <%= render(Forms::Component.new(
        label: "Departure Date",
        name: "#{form.object_name}[departure_date]",
        id: form.field_id(:departure_date),
        error: form_error(ride_post, :departure_date)
      )) do |field| %>
        <%= date_field_tag "#{form.object_name}[departure_date]", regular ? nil : ride_post.departure_date,
                            id: form.field_id(:departure_date), data: { ride_creation_target: "date" }, class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4",
                            min: Date.current.to_fs(:db), **field.input_attributes %>
      <% end %>
    </fieldset>

    <fieldset class="col-span-full min-w-0 space-y-4" data-ride-creation-target="regularFields" <%= tag.attributes(hidden: !regular, disabled: !regular) %>>
      <legend class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Weekly schedule</legend>
      <% if schedule.source_ride_post_id %>
        <%= hidden_field_tag "#{form.object_name}[source_ride_post_id]", schedule.source_ride_post_id %>
        <p class="text-sm text-neutral-500">Your original draft will be preserved. Confirm the days, time and passenger seats before publishing.</p>
      <% end %>
      <fieldset class="min-w-0 space-y-3" <%= tag.attributes(aria: { invalid: form_error(schedule, :weekday_ids).present? ? "true" : nil, describedby: form_error(schedule, :weekday_ids).present? ? "#{form.field_id(:weekday_ids)}_error" : nil }) %>>
        <legend class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Repeat on</legend>
        <%= hidden_field_tag "#{form.object_name}[weekday_ids][]", "" %>
        <div class="grid grid-cols-3 sm:grid-cols-7 gap-2">
          <% RideSchedule::WEEKDAYS.each do |label, day| %>
            <%= render Checkbox::Component.new(label: safe_join([tag.span(label.first(3), aria: { hidden: true }), tag.span(label, class: "sr-only")]),
              name: "#{form.object_name}[weekday_ids][]", value: day, checked: schedule.weekday_ids.include?(day), id: form.field_id(:weekday, day),
              classes: "min-w-0 min-h-11 rounded-xl border border-neutral-200 dark:border-neutral-700 px-1.5 has-checked:border-blue-500 has-checked:bg-blue-50 dark:has-checked:bg-blue-950/30",
              input_classes: "shrink-0 text-blue-600 accent-blue-600 focus:ring-blue-500 dark:checked:bg-blue-600", label_classes: "flex min-h-11 items-center cursor-pointer",
              data: { ride_creation_target: "weekday", day_label: label.first(3) }) %>
          <% end %>
        </div>
        <% if form_error(schedule, :weekday_ids) %>
          <p id="<%= form.field_id(:weekday_ids) %>_error" class="text-sm text-red-700 dark:text-red-400"><%= form_error(schedule, :weekday_ids) %></p>
        <% end %>
        <div class="flex flex-wrap gap-2">
          <%= render Buttons::Component.new(text: "Weekdays", variant: :ghost, size: :sm, data: { action: "ride-creation#selectWeekdays" }) %>
          <%= render Buttons::Component.new(text: "Every day", variant: :ghost, size: :sm, data: { action: "ride-creation#selectEveryDay" }) %>
        </div>
      </fieldset>
      <div data-ride-creation-target="endDateToggle" data-action="change->ride-creation#changeEndDate">
        <%= render Switch::Component.new(label: "Set an end date", id: form.field_id(:end_date_enabled), checked: schedule.end_date.present?) %>
      </div>
      <%= hidden_field_tag "#{form.object_name}[end_date]", "" %>
      <fieldset class="min-w-0" data-ride-creation-target="endDateFields" <%= tag.attributes(hidden: schedule.end_date.blank?, disabled: schedule.end_date.blank?) %>>
        <legend class="sr-only">Schedule end date</legend>
        <%= render(Forms::Component.new(label: "Repeat until", name: :end_date, id: form.field_id(:end_date), error: form_error(schedule, :end_date))) do |field| %>
          <%= date_field_tag "#{form.object_name}[end_date]", schedule.end_date, id: form.field_id(:end_date), min: Date.current.to_fs(:db),
            data: { ride_creation_target: "endDate" }, class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
        <% end %>
      </fieldset>
      <p class="text-sm text-neutral-500">Repeats until you pause or end the schedule, unless you set an end date. Passengers book one departure at a time, up to 14 days ahead.</p>
    </fieldset>

    <!-- Departure Choice -->
    <fieldset class="col-span-full min-w-0 space-y-3 rounded-xl" data-controller="departure-choice" data-action="morph-draft:restored@document->departure-choice#restoreDraft" data-form-error-id="<%= form.field_id(:departure_choice) %>_error"
      <%= tag.attributes(aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil }) %>>
      <legend class="block text-sm font-semibold text-neutral-900 dark:text-neutral-100">Departure Schedule</legend>
      <% if form_error(ride_post, :departure_choice) %>
        <p id="<%= form.field_id(:departure_choice) %>_error" class="text-sm text-red-700 dark:text-red-400"><%= form_error(ride_post, :departure_choice) %></p>
      <% end %>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
        <!-- Morning -->
        <label class="relative min-w-0 flex flex-col p-2.5 sm:p-3.5 rounded-2xl border cursor-pointer transition-all border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 has-checked:border-blue-500 has-checked:bg-blue-50/70 dark:has-checked:bg-blue-950/30">
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 mb-1.5">
            <%= form.radio_button :departure_choice, :morning, data: { action: "change->departure-choice#change", ride_creation_target: "departureChoice" }, class: "size-4 shrink-0 text-blue-600 focus:ring-blue-500",
              aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil },
              "data-form-error-rule": form_error(ride_post, :departure_choice).present? ? "required" : nil %>
            <svg class="hidden sm:block size-4.5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <span class="min-w-0 [overflow-wrap:anywhere] text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white">Morning</span>
          </div>
          <span class="text-xs text-neutral-500 dark:text-neutral-400 sm:pl-6">06:00–12:00</span>
        </label>

        <!-- Afternoon -->
        <label class="relative min-w-0 flex flex-col p-2.5 sm:p-3.5 rounded-2xl border cursor-pointer transition-all border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 has-checked:border-blue-500 has-checked:bg-blue-50/70 dark:has-checked:bg-blue-950/30">
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 mb-1.5">
            <%= form.radio_button :departure_choice, :afternoon, data: { action: "change->departure-choice#change", ride_creation_target: "departureChoice" }, class: "size-4 shrink-0 text-blue-600 focus:ring-blue-500",
              aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil },
              "data-form-error-rule": form_error(ride_post, :departure_choice).present? ? "required" : nil %>
            <svg class="hidden sm:block size-4.5 text-orange-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12ZM2.25 12h1.5m16.5 0h1.5m-15.364-6.364 1.06 1.06m12.728 0 1.06-1.06M12 2.25v1.5" />
            </svg>
            <span class="min-w-0 [overflow-wrap:anywhere] text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white">Afternoon</span>
          </div>
          <span class="text-xs text-neutral-500 dark:text-neutral-400 sm:pl-6">12:00–17:00</span>
        </label>

        <!-- Evening -->
        <label class="relative min-w-0 flex flex-col p-2.5 sm:p-3.5 rounded-2xl border cursor-pointer transition-all border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 has-checked:border-blue-500 has-checked:bg-blue-50/70 dark:has-checked:bg-blue-950/30">
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 mb-1.5">
            <%= form.radio_button :departure_choice, :evening, data: { action: "change->departure-choice#change", ride_creation_target: "departureChoice" }, class: "size-4 shrink-0 text-blue-600 focus:ring-blue-500",
              aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil },
              "data-form-error-rule": form_error(ride_post, :departure_choice).present? ? "required" : nil %>
            <svg class="hidden sm:block size-4.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25M12 18.75V21M3 12h2.25m.386-6.364 1.591 1.591M3 17.25h18M5.25 21h13.5" />
            </svg>
            <span class="min-w-0 [overflow-wrap:anywhere] text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white">Evening</span>
          </div>
          <span class="text-xs text-neutral-500 dark:text-neutral-400 sm:pl-6">17:00–21:00</span>
        </label>

        <!-- Night -->
        <label class="relative min-w-0 flex flex-col p-2.5 sm:p-3.5 rounded-2xl border cursor-pointer transition-all border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 has-checked:border-blue-500 has-checked:bg-blue-50/70 dark:has-checked:bg-blue-950/30">
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 mb-1.5">
            <%= form.radio_button :departure_choice, :night, data: { action: "change->departure-choice#change", ride_creation_target: "departureChoice" }, class: "size-4 shrink-0 text-blue-600 focus:ring-blue-500",
              aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil },
              "data-form-error-rule": form_error(ride_post, :departure_choice).present? ? "required" : nil %>
            <svg class="hidden sm:block size-4.5 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
            <span class="min-w-0 [overflow-wrap:anywhere] text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white">Night</span>
          </div>
          <span class="text-xs text-neutral-500 dark:text-neutral-400 sm:pl-6">21:00–midnight</span>
        </label>

        <!-- Exact Time -->
        <label class="relative min-w-0 flex flex-col p-2.5 sm:p-3.5 rounded-2xl border cursor-pointer transition-all border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 has-checked:border-blue-500 has-checked:bg-blue-50/70 dark:has-checked:bg-blue-950/30">
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 mb-1.5">
            <%= form.radio_button :departure_choice, :exact_time, data: { action: "change->departure-choice#change", ride_creation_target: "departureChoice" }, class: "size-4 shrink-0 text-blue-600 focus:ring-blue-500",
              aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil },
              "data-form-error-rule": form_error(ride_post, :departure_choice).present? ? "required" : nil %>
            <svg class="hidden sm:block size-4.5 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span class="min-w-0 [overflow-wrap:anywhere] text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white">Exact Time</span>
          </div>
          <span class="text-xs text-neutral-500 dark:text-neutral-400 sm:pl-6">Specify exact departure</span>
        </label>

        <!-- Flexible -->
        <label class="relative min-w-0 flex flex-col p-2.5 sm:p-3.5 rounded-2xl border cursor-pointer transition-all border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 hover:bg-blue-50/50 dark:hover:bg-blue-950/20 has-checked:border-blue-500 has-checked:bg-blue-50/70 dark:has-checked:bg-blue-950/30">
          <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2 mb-1.5">
            <%= form.radio_button :departure_choice, :flexible, data: { action: "change->departure-choice#change", ride_creation_target: "departureChoice" }, class: "size-4 shrink-0 text-blue-600 focus:ring-blue-500",
              aria: { invalid: form_error(ride_post, :departure_choice).present? ? "true" : nil, describedby: form_error(ride_post, :departure_choice).present? ? "#{form.field_id(:departure_choice)}_error" : nil },
              "data-form-error-rule": form_error(ride_post, :departure_choice).present? ? "required" : nil %>
            <svg class="hidden sm:block size-4.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
            </svg>
            <span class="min-w-0 [overflow-wrap:anywhere] text-xs sm:text-sm font-semibold text-neutral-900 dark:text-white">Flexible</span>
          </div>
          <span class="text-xs text-neutral-500 dark:text-neutral-400 sm:pl-6">Any time on date</span>
        </label>
      </div>

      <!-- Exact Time Picker Container -->
      <div data-departure-choice-target="exactTimeField" class="<%= 'hidden' unless ride_post.exact_time? %> pt-2">
        <%= render(Forms::Component.new(
          label: "Departure Time",
          helper_text: "Choose exact departure time (including midnight–06:00)",
          name: time_attribute,
          id: form.field_id(time_attribute),
          error: form_error(ride_post, regular ? :departure_clock : :exact_departure_time)
        )) do |field| %>
          <%= time_field_tag "#{form.object_name}[#{time_attribute}]", departure_clock,
                              id: form.field_id(time_attribute), data: { ride_creation_target: "time" },
                              class: "block w-full sm:w-64 rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4", **field.input_attributes %>
        <% end %>
      </div>
    </fieldset>

    <!-- Seats Available/Needed -->
    <%= render(Forms::Component.new(
      label: tag.span(regular ? "Passenger seats per departure" : "Available passenger seats", data: { ride_creation_target: "seatsLabel" }),
      helper_text: "Passenger places offered in your car; this count excludes the driver.",
      name: :seats,
      id: form.field_id(:seats),
      error: form_error(ride_post, :seats)
    )) do |field| %>
      <div class="flex items-center gap-2" data-controller="seat-stepper">
        <button type="button" aria-label="Remove one passenger seat" title="Remove one passenger seat" data-action="seat-stepper#decrease" class="size-11 sm:size-12 shrink-0 inline-flex items-center justify-center rounded-xl font-bold text-lg border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-blue-600 transition select-none">−</button>
        <%= form.number_field :seats, min: 1, step: 1, data: { seat_stepper_target: "input", ride_creation_target: "seats" },
            class: "block w-full min-w-0 rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 py-3 px-4", **field.input_attributes %>
        <button type="button" aria-label="Add one passenger seat" title="Add one passenger seat" data-action="seat-stepper#increase" class="size-11 sm:size-12 shrink-0 inline-flex items-center justify-center rounded-xl font-bold text-lg border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-blue-600 transition select-none">+</button>
      </div>
    <% end %>

    <% if Current.user&.female? %>
      <div class="col-span-full border-t border-neutral-100 dark:border-white/5 pt-4">
        <label class="flex items-center gap-3 p-3.5 rounded-xl border border-rose-200 dark:border-rose-900/30 bg-rose-50/50 dark:bg-rose-950/20 cursor-pointer hover:bg-rose-100/50 transition-colors">
          <%= form.check_box :ladies_only, class: "rounded text-rose-600 focus:ring-rose-500 size-4" %>
          <div>
            <span class="text-sm font-semibold text-rose-900 dark:text-rose-300 block">Ladies Only Carpool</span>
            <span class="text-xs text-rose-700 dark:text-rose-400">Reserve seats for female passengers. You retain discretion to review and accept requests.</span>
          </div>
        </label>
      </div>
    <% end %>

    <!-- Audience & Community Visibility -->
    <div class="col-span-full border-t border-neutral-100 dark:border-white/5 pt-4 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">Audience & Visibility</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <%= render(Forms::Component.new(
          label: "Visibility",
          name: :visibility,
          id: form.field_id(:visibility),
          error: form_error(ride_post, :visibility)
        )) do |field| %>
          <%= form.select :visibility, [["Public (Everyone)", "public_ride"], ["Community / Closed Hub Only", "hub_only"]], {},
              class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4", **field.input_attributes %>
        <% end %>

        <% verified_communities = Current.user&.verified_communities || [] %>
        <%= render(Forms::Component.new(
          label: "Community Hub (for hub-only rides)",
          name: :community_id,
          id: form.field_id(:community_id),
          error: form_error(ride_post, :community_id)
        )) do |field| %>
          <%= form.collection_select :community_id, verified_communities, :id, :name, { include_blank: "Select your community..." },
              class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4", **field.input_attributes %>
        <% end %>
      </div>

      <% if verified_communities.none? %>
        <p class="text-xs text-neutral-500">
          Want to restrict rides to your company or university campus? Visit <%= link_to "Hubs", communities_path, class: "text-blue-600 underline font-medium" %> to verify your institutional email.
        </p>
      <% end %>
    </div>

    <!-- Notes -->
    <%= render(Forms::Component.new(
      label: "Details & Preferences",
      name: :notes,
      id: form.field_id(:notes),
      helper_text: ride_post.persisted? && ride_post.notes.to_s.length > 300 ? "Existing longer notes may be kept unchanged; edited notes must be 300 characters or fewer." : "Optional. Up to 300 characters.",
      classes: "col-span-full",
      error: form_error(ride_post, :notes)
    )) do |field| %>
      <%= form.text_area :notes, rows: 4, maxlength: (300 unless ride_post.persisted? && ride_post.notes.to_s.length > 300),
          class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4", 
          placeholder: "e.g., I have a small dog, specific pick-up point near landmark, luggage notes...", **field.input_attributes %>
    <% end %>
  </div>

  <p class="text-sm font-semibold text-neutral-700 dark:text-neutral-300" data-ride-creation-target="summary" aria-live="polite"></p>

  <!-- Form Action -->
  <div class="flex flex-wrap items-center gap-3 pt-6 border-t border-neutral-100 dark:border-white/5">
    <% if ride_post.new_record? || ride_post.draft? %>
      <%= render Buttons::Component.new(text: "Save draft", type: "submit", name: "intent", value: "draft", variant: :outline) %>
      <%= render Buttons::Component.new(text: regular ? "Publish regular ride" : "Publish ride", type: "submit", name: "intent", value: "publish", data: { ride_creation_target: "publishButton" }) %>
    <% else %>
      <%= render Buttons::Component.new(text: regular ? "Save schedule" : "Save Changes", type: "submit", name: "intent", value: "save") %>
    <% end %>

    <%= yield %>
  </div>

<% end %>
