<% grouped_locations = local_assigns[:grouped_locations] || Location.grouped_by_region %>
<%= form_with(model: ride_post, class: "w-full space-y-6") do |form| %>
  <% if ride_post.errors.any? %>
    <div id="error_explanation" class="bg-red-50 dark:bg-red-900/10 text-red-600 px-4 py-3 font-medium rounded-xl mt-3 mb-6 border border-red-100 dark:border-red-900/20">
      <h2 class="text-sm font-bold uppercase tracking-wider mb-2"><%= pluralize(ride_post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul class="list-disc ml-6 text-sm opacity-90">
        <% ride_post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Post Type (Enum) -->
    <%= render(Forms::Component.new(
      label: "Ride Intent",
      name: :post_type,
      id: form.field_id(:post_type),
      classes: "col-span-full",
      error: ride_post.errors[:post_type].first
    )) do %>
      <%= form.select :post_type, RidePost.post_types.keys.map { |pt| [pt.titleize, pt] }, {}, 
          class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4" %>
    <% end %>

    <!-- Origin Location -->
    <%= render(Forms::Component.new(
      label: "Leaving from (City)",
      name: "ride_post[origin_id]",
      id: form.field_id(:origin_id),
      error: ride_post.errors[:origin].first || ride_post.errors[:origin_id].first
    )) do %>
      <%= render Combobox::Component.new(
                 name: "ride_post[origin_id]",
                 id: "ride_post_origin_id",
                 grouped_options: grouped_locations,
                 selected: ride_post.origin_id,
                 placeholder: "Select a city...") %>
    <% end %>

    <!-- Destination Location -->
    <%= render(Forms::Component.new(
      label: "Going to (City)",
      name: "ride_post[destination_id]",
      id: form.field_id(:destination_id),
      error: ride_post.errors[:destination].first || ride_post.errors[:destination_id].first
    )) do %>
      <%= render Combobox::Component.new(
                 name: "ride_post[destination_id]",
                 id: "ride_post_destination_id",
                 grouped_options: grouped_locations,
                 selected: ride_post.destination_id,
                 placeholder: "Select a city...") %>
    <% end %>

    <!-- Departure Time -->
    <%= render(Forms::Component.new(
      label: "Departure Time (required to publish a ride offer)",
      name: :departure_time,
      id: form.field_id(:departure_time),
      error: ride_post.errors[:departure_time].first
    )) do %>
      <%= form.datetime_field :departure_time,
                              class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4",
                              min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
    <% end %>

    <!-- Expected Arrival Time -->
    <%= render(Forms::Component.new(
      label: "Expected Arrival Time (required for ride offers)",
      name: :expected_arrival_at,
      id: form.field_id(:expected_arrival_at),
      error: ride_post.errors[:expected_arrival_at].first
    )) do %>
      <%= form.datetime_field :expected_arrival_at,
                              class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4",
                              min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
    <% end %>

    <!-- Seats Available/Needed -->
    <%= render(Forms::Component.new(
      label: "Seats",
      name: :seats,
      id: form.field_id(:seats),
      error: ride_post.errors[:seats].first
    )) do %>
      <%= form.number_field :seats, min: 1, 
          class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4" %>
    <% end %>

    <!-- Cost Sharing Tags & Community Policies -->
    <div class="col-span-full border-t border-neutral-100 dark:border-white/5 pt-4 space-y-3">
      <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">Cost Sharing (Non-Commercial)</h3>
      <p class="text-xs text-neutral-500">Pasabaya is a community carpool matching tool. Commercial passenger transport and fixed fares are prohibited on the platform.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <label class="flex items-center gap-3 p-3.5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-750 transition-colors">
          <%= form.check_box :is_free_ride, class: "rounded text-blue-600 focus:ring-blue-500 size-4" %>
          <div>
            <span class="text-sm font-semibold text-neutral-900 dark:text-white block">Libreng Sakay</span>
            <span class="text-xs text-neutral-500">100% Free community ride</span>
          </div>
        </label>

        <label class="flex items-center gap-3 p-3.5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-750 transition-colors">
          <%= form.check_box :share_tolls, class: "rounded text-blue-600 focus:ring-blue-500 size-4" %>
          <div>
            <span class="text-sm font-semibold text-neutral-900 dark:text-white block">Share Tolls</span>
            <span class="text-xs text-neutral-500">Split RFID / Expressways</span>
          </div>
        </label>

        <label class="flex items-center gap-3 p-3.5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-750 transition-colors">
          <%= form.check_box :split_gas, class: "rounded text-blue-600 focus:ring-blue-500 size-4" %>
          <div>
            <span class="text-sm font-semibold text-neutral-900 dark:text-white block">Split Gas</span>
            <span class="text-xs text-neutral-500">Modest fuel contribution</span>
          </div>
        </label>
      </div>

      <% if Current.user&.female? %>
        <div class="pt-1">
          <label class="flex items-center gap-3 p-3.5 rounded-xl border border-rose-200 dark:border-rose-900/30 bg-rose-50/50 dark:bg-rose-950/20 cursor-pointer hover:bg-rose-100/50 transition-colors">
            <%= form.check_box :ladies_only, class: "rounded text-rose-600 focus:ring-rose-500 size-4" %>
            <div>
              <span class="text-sm font-semibold text-rose-900 dark:text-rose-300 block">Ladies Only Carpool</span>
              <span class="text-xs text-rose-700 dark:text-rose-400">Reserve seats for female passengers. You retain discretion to review and accept requests.</span>
            </div>
          </label>
        </div>
      <% end %>
    </div>

    <!-- Audience & Community Visibility -->
    <div class="col-span-full border-t border-neutral-100 dark:border-white/5 pt-4 space-y-4">
      <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">Audience & Visibility</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= render(Forms::Component.new(
          label: "Visibility",
          name: :visibility,
          id: form.field_id(:visibility),
          error: ride_post.errors[:visibility].first
        )) do %>
          <%= form.select :visibility, [["Public (Everyone)", "public_ride"], ["Community / Closed Hub Only", "hub_only"]], {},
              class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4" %>
        <% end %>

        <% verified_communities = Current.user&.verified_communities || [] %>
        <%= render(Forms::Component.new(
          label: "Community Hub (for hub-only rides)",
          name: :community_id,
          id: form.field_id(:community_id),
          error: ride_post.errors[:community_id].first || ride_post.errors[:community].first
        )) do %>
          <%= form.collection_select :community_id, verified_communities, :id, :name, { include_blank: "Select your community..." },
              class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4" %>
        <% end %>
      </div>

      <% if verified_communities.none? %>
        <p class="text-xs text-neutral-500">
          Want to restrict rides to your company or university campus? Visit <%= link_to "Hubs", communities_path, class: "text-blue-600 underline font-medium" %> to verify your institutional email.
        </p>
      <% end %>
    </div>

    <!-- Notes -->
    <%= render(Forms::Component.new(
      label: "Details & Preferences",
      name: :notes,
      id: form.field_id(:notes),
      classes: "col-span-full",
      error: ride_post.errors[:notes].first
    )) do %>
      <%= form.text_area :notes, rows: 4, 
          class: "block w-full rounded-xl border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-base sm:text-sm text-neutral-900 dark:text-white focus:ring-blue-500 focus:border-blue-500 transition-all py-3 px-4", 
          placeholder: "e.g., Willing to split gas, I have a small dog, specific pick-up points..." %>
    <% end %>
  </div>

  <!-- Form Action -->
  <div class="flex items-center gap-6 pt-6 border-t border-neutral-100 dark:border-white/5">
    <%= render Buttons::Component.new(
               text: ride_post.new_record? ? "Save Post" : "Save Changes",
               type: "submit",
               size: :lg) %>

    <%= yield %>
  </div>

<% end %>
