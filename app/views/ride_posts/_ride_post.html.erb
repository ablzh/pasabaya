<%# 1. Build the Footer (User Info + Actions) %>
<% card_footer = capture do %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <%# Left side: User Info %>
    <div class="flex items-center">
      <%= user_avatar(ride_post.user, classes: "h-9 w-9 text-xs") %>
      <div class="ml-2">
        <p class="text-sm font-semibold text-neutral-900 dark:text-white leading-none">
          <%= ride_post.user.first_name %> <%= ride_post.user.last_name %>
        </p>
        <p class="text-[10px] text-neutral-500 mt-1">
          Posted <%= time_ago_in_words(ride_post.created_at) %> ago
        </p>
      </div>
    </div>

    <%# Right side: Actions %>
    <div class="flex flex-wrap items-center gap-2">
      <% if Current.user == ride_post.user %>
        <%= render Buttons::Component.new(
                   text: "Edit",
                   classes: "relative z-20",
                   href: edit_ride_post_path(ride_post),
                   variant: :secondary,
                   size: :xs,
                   pill: true) %>
      <% end %>

    </div>
  </div>
<% end %>

<%# 2. Render the Component %>
<div id="<%= dom_id ride_post %>" class="w-full h-full">
  <%= render(Card::Component.new(
             divide: true,
             hoverable: true,
             classes: "relative h-full flex flex-col [&>div:last-child]:mt-auto",
             padding: :sm)) do |card| %>
    <% card.with_body do %>
      <%= link_to ride_post_path(ride_post), class: "absolute inset-0 z-10 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600", aria: { label: "View ride: #{ride_post.origin&.name || 'Choose origin'} to #{ride_post.destination&.name || 'Choose destination'}" } do %>
        <span class="sr-only">View ride details</span>
      <% end %>
      <%# Top Row: Badge + Badges + Seats %>
      <div class="flex justify-between items-start mb-3 gap-2">
        <div class="flex flex-wrap items-center gap-1.5">
          <% if ride_post.draft? || ride_post.canceled? || ride_post.completed? %>
            <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500"><%= ride_post.completed? ? "Past" : ride_post.status.humanize %></span>
          <% end %>

          <% if ride_post.full? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
              Full
            </span>
          <% end %>

          <% if ride_post.ladies_only? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300">
              Ladies Only
            </span>
          <% end %>

          <% if ride_post.hub_only? && ride_post.community %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-purple-50 text-purple-700 dark:bg-purple-950/40 dark:text-purple-300">
              <%= ride_post.community.name %> Hub
            </span>
          <% end %>
        </div>

        <div class="flex items-center text-neutral-500 shrink-0">
          <% if ride_post.remaining_seats.present? %>
            <span class="text-xs font-bold text-neutral-900 dark:text-white"><%= ride_post.remaining_seats %>/<%= ride_post.seats %></span>
            <span class="text-[10px] ml-1 uppercase">left</span>
          <% else %>
            <span class="text-xs font-bold text-neutral-900 dark:text-white"><%= pluralize(ride_post.seats, "seat") %> planned</span>
          <% end %>
        </div>
      </div>

      <%# The Trip: Clear Arrow Route %>
      <div class="mb-4">
        <h3 class="text-lg font-bold text-neutral-900 dark:text-white leading-tight">
          <%= (ride_post.origin&.name || "Choose origin") %> → <%= (ride_post.destination&.name || "Choose destination") %>
        </h3>

        <%# Departure Time %>
        <div class="mt-2 flex items-center gap-1.5 text-blue-600 dark:text-blue-400">
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span class="text-xs font-bold tracking-tight">
            <% if ride_post.exact_time? && ride_post.departure_time.present? %>
              <%= ride_post.departure_time.strftime("%a, %b %d • %H:%M") %>
            <% elsif ride_post.departure_date.present? %>
              <%= ride_post.departure_date.strftime("%a, %b %d") %> • <%= ride_post.departure_choice_human %>
            <% elsif ride_post.departure_time.present? %>
              <%= ride_post.departure_time.strftime("%a, %b %d • %H:%M") %>
            <% else %>
              Regular/Flexible Ride
            <% end %>
          </span>
        </div>
      </div>

      <%# Notes: Controlled height with line-clamp %>
      <% if ride_post.notes.present? %>
        <div class="mt-3 pt-3 border-t border-neutral-100 dark:border-white/5">
          <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
            <%= ride_post.notes.truncate(110) %>
          </p>
        </div>
      <% end %>
    <% end %>

    <% card.with_footer do %>
      <%= card_footer %>
    <% end %>
  <% end %>
</div>
