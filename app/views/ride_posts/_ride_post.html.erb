<%# 1. Build the Footer (User Info + Actions) %>
<% card_footer = capture do %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <%# Left side: User Info %>
    <%= link_to user_path(ride_post.user), class: "flex items-center group" do %>
      <%= user_avatar(ride_post.user, classes: "h-9 w-9 text-xs transition-opacity group-hover:opacity-80") %>
      <div class="ml-2">
        <p class="text-sm font-semibold text-neutral-900 dark:text-white leading-none group-hover:underline">
          <%= ride_post.user.first_name %> <%= ride_post.user.last_name %>
        </p>
        <p class="text-[10px] text-neutral-500 mt-1">
          Posted <%= time_ago_in_words(ride_post.created_at) %> ago
        </p>
      </div>
    <% end %>

    <%# Right side: Actions %>
    <div class="flex flex-wrap items-center gap-2">
      <%= render Buttons::Component.new(
                 text: "Show",
                 href: ride_post_path(ride_post),
                 variant: :secondary,
                 size: :xs,
                 pill: true) %>

      <% if Current.user == ride_post.user %>
        <%= render Buttons::Component.new(
                   text: "Edit",
                   href: edit_ride_post_path(ride_post),
                   variant: :secondary,
                   size: :xs,
                   pill: true) %>
      <% end %>

    </div>
  </div>
<% end %>

<%# 2. Render the Component %>
<div id="<%= dom_id ride_post %>" class="w-full h-full">
  <%= render(Card::Component.new(
             divide: true,
             hoverable: true,
             padding: :sm)) do |card| %>
    <% card.with_body do %>
      <%# Top Row: Badge + Badges + Seats %>
      <div class="flex justify-between items-start mb-3 gap-2">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider
            <%= ride_post.offering? ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400' : 'bg-sky-100 text-sky-700 dark:bg-sky-500/10 dark:text-sky-400' %>">
            <%= ride_post.post_type %>
          </span>

          <% if ride_post.full? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
              Full
            </span>
          <% end %>

          <% if ride_post.is_free_ride? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
              Libreng Sakay
            </span>
          <% end %>

          <% if ride_post.share_tolls? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-300">
              Tolls
            </span>
          <% end %>

          <% if ride_post.split_gas? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300">
              Gas
            </span>
          <% end %>

          <% if ride_post.ladies_only? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300">
              Ladies Only
            </span>
          <% end %>
        </div>

        <div class="flex items-center text-neutral-500 shrink-0">
          <% if ride_post.offering? && ride_post.remaining_seats.present? %>
            <span class="text-xs font-bold text-neutral-900 dark:text-white"><%= ride_post.remaining_seats %>/<%= ride_post.seats %></span>
            <span class="text-[10px] ml-1 uppercase">left</span>
          <% else %>
            <span class="text-xs font-bold text-neutral-900 dark:text-white"><%= ride_post.seats %></span>
            <span class="text-[10px] ml-1 uppercase">seats</span>
          <% end %>
        </div>
      </div>

      <%# The Trip: Clear Arrow Route %>
      <div class="mb-4">
        <h3 class="text-lg font-bold text-neutral-900 dark:text-white leading-tight">
          <%= ride_post.origin.name %> → <%= ride_post.destination.name %>
        </h3>

        <%# Departure Time %>
        <div class="mt-2 flex items-center gap-1.5 text-blue-600 dark:text-blue-400">
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span class="text-xs font-bold tracking-tight">
            <% if ride_post.regular? %>
              Regular/Flexible Ride
            <% else %>
              <%= ride_post.departure_time.strftime("%a, %b %d • %H:%M") %>
            <% end %>
          </span>
        </div>
      </div>

      <%# Notes: Controlled height with line-clamp %>
      <% if ride_post.notes.present? %>
        <div class="mt-3 pt-3 border-t border-neutral-100 dark:border-white/5">
          <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed">
            <%= ride_post.notes %>
          </p>
        </div>
      <% end %>
    <% end %>

    <% card.with_footer do %>
      <%= card_footer %>
    <% end %>
  <% end %>
</div>
