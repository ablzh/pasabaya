<div id="<%= dom_id(ride_post, :driver_requests) %>" class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 rounded-3xl shadow-xs space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">Seat Requests &amp; Confirmed Passengers</h2>
    <% if ride_post.requests_closed_at.nil? && ride_post.booking_cutoff_at&.future? %>
      <div class="space-y-2 max-w-xs">
        <%= button_to "Close seat requests", close_requests_ride_post_path(ride_post), method: :patch, id: dom_id(ride_post, :close_requests), form: { id: dom_id(ride_post, :close_requests_form) },
                      data: { turbo_confirm: "Are you sure you want to close seat requests? This will stop new requests and expire any unanswered pending requests." },
                      class: "px-4 py-2 text-sm font-semibold rounded-xl border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-100 hover:bg-neutral-50 dark:hover:bg-neutral-800 cursor-pointer" %>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">Stop new requests and expire unanswered ones. Confirmed passengers and trip chat remain available.</p>
      </div>
    <% elsif ride_post.requests_closed_at.present? && ride_post.booking_cutoff_at&.future? %>
      <div class="space-y-2 max-w-xs">
        <%= button_to "Reopen seat requests", reopen_requests_ride_post_path(ride_post), method: :patch, id: dom_id(ride_post, :reopen_requests), form: { id: dom_id(ride_post, :reopen_requests_form) },
                      class: "px-4 py-2 text-sm font-semibold rounded-xl border border-blue-600 dark:border-blue-500 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/30 cursor-pointer" %>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">Seat requests are closed. Reopen to allow passengers to request seats again.</p>
      </div>
    <% end %>
  </div>

  <div>
    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-400 mb-3">Pending Requests (<%= pending_bookings.length %>)</h3>
    <% if pending_bookings.any? %>
      <div class="space-y-3">
        <% pending_bookings.each do |b| %>
          <div id="<%= dom_id(b) %>" class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl border border-neutral-100 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-800/50 gap-3">
            <div class="flex min-w-0 flex-1 items-center gap-3">
              <%= user_avatar(b.passenger, classes: "h-10 w-10 text-sm shrink-0") %>
              <div class="min-w-0 flex-1 [overflow-wrap:anywhere]">
                <p class="font-bold text-sm text-neutral-900 dark:text-white"><%= link_to "#{b.passenger.first_name} #{b.passenger.last_name}", user_path(b.passenger), id: dom_id(b, :passenger_profile), class: "underline hover:no-underline" %></p>
                <% if b.pickup_notes.present? %>
                  <p class="text-xs text-neutral-500 mt-0.5">"<%= b.pickup_notes %>"</p>
                <% end %>
              </div>
            </div>
            <div class="flex items-center gap-2 self-end sm:self-auto">
              <%= button_to "Accept", accept_booking_path(b), method: :patch, disabled: !can_accept, id: dom_id(b, :accept), form: { id: dom_id(b, :accept_form) }, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors cursor-pointer disabled:cursor-not-allowed disabled:opacity-50" %>
              <%= button_to "Decline", decline_booking_path(b), method: :patch, id: dom_id(b, :decline), form: { id: dom_id(b, :decline_form) }, class: "px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-300 dark:hover:bg-neutral-600 transition-colors cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-neutral-500 italic">No pending requests at the moment.</p>
    <% end %>
  </div>

  <div class="border-t border-neutral-100 dark:border-neutral-800 pt-4">
    <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-400 mb-3">Confirmed Passengers (<%= accepted_bookings.length %> / <%= ride_post.seats %>)</h3>
    <% if accepted_bookings.any? %>
      <div class="space-y-3">
        <% accepted_bookings.each do |b| %>
          <div id="<%= dom_id(b) %>" class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl border border-emerald-100 dark:border-emerald-900/30 bg-emerald-50/50 dark:bg-emerald-950/20 gap-3">
            <div class="flex min-w-0 flex-1 items-center gap-3">
              <%= user_avatar(b.passenger, classes: "h-10 w-10 text-sm shrink-0") %>
              <div class="min-w-0 flex-1 [overflow-wrap:anywhere]">
                <p class="font-bold text-sm text-neutral-900 dark:text-white"><%= link_to "#{b.passenger.first_name} #{b.passenger.last_name}", user_path(b.passenger), id: dom_id(b, :passenger_profile), class: "underline hover:no-underline" %></p>
                <% if b.pickup_notes.present? %>
                  <p class="text-xs text-neutral-500 mt-0.5">"<%= b.pickup_notes %>"</p>
                <% end %>
              </div>
            </div>
            <div class="self-end sm:self-auto shrink-0">
              <%= button_to "Cancel Seat", cancel_booking_path(b), method: :patch, id: dom_id(b, :cancel), form: { id: dom_id(b, :cancel_form) }, data: { turbo_confirm: "Are you sure you want to cancel this passenger's seat?" }, class: "px-3 py-1.5 text-xs font-semibold rounded-lg text-red-600 hover:bg-red-50 dark:hover:bg-red-950/20 transition-colors cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-neutral-500 italic">No confirmed passengers yet.</p>
    <% end %>
  </div>
</div>
