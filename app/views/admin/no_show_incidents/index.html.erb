<h1 class="text-2xl font-bold">No-show incidents</h1>
<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Review participant reports before confirming a no-show. The queue opens with cases needing review.</p>

<%= render "admin/shared/filters", url: admin_no_show_incidents_path, category: :status,
           filters: @filters, filter_errors: @filter_errors,
           choices: [["Needs review", "open"], ["All statuses", "all"], *NoShowIncident.statuses.keys.map { |status| [status.humanize, status] }] %>

<div class="space-y-4">
  <% @incidents.each do |incident| %>
    <article id="<%= dom_id(incident) %>" class="rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-700 dark:bg-neutral-900">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h2 class="font-semibold"><%= link_to "Incident ##{incident.id}", admin_no_show_incident_path(incident), class: "underline underline-offset-4" %></h2>
        <%= admin_status_badge(incident.status) %>
      </div>
      <p class="mt-2 text-sm"><%= admin_user_name(incident.user) %></p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400"><%= admin_route_name(incident.ride_post) %> · Trip #<%= incident.ride_post_id %></p>
      <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Occurred <%= admin_timestamp(incident.occurred_at) %></p>
    </article>
  <% end %>
  <% if @incidents.empty? %>
    <p class="rounded-xl border border-neutral-200 p-6 text-sm dark:border-neutral-700">No incidents match these filters.</p>
  <% end %>
</div>
