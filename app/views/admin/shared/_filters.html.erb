<%= form_with url: url, method: :get, class: "my-6 rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-700 dark:bg-neutral-900" do |form| %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    <div>
      <%= form.label category, category.to_s.humanize, class: "text-sm font-medium" %>
      <%= form.select category, choices, { selected: filters[category] }, class: admin_field_classes %>
    </div>
    <div>
      <%= form.label :ride_post_id, "Trip ID", class: "text-sm font-medium" %>
      <%= form.number_field :ride_post_id, value: filters[:ride_post_id], min: 1, class: admin_field_classes %>
    </div>
    <div>
      <%= form.label :user_id, "User ID", class: "text-sm font-medium" %>
      <%= form.number_field :user_id, value: filters[:user_id], min: 1, class: admin_field_classes %>
    </div>
    <div>
      <%= form.label :from, "From date", class: "text-sm font-medium" %>
      <%= form.date_field :from, value: filters[:from], class: admin_field_classes %>
    </div>
    <div>
      <%= form.label :to, "To date", class: "text-sm font-medium" %>
      <%= form.date_field :to, value: filters[:to], class: admin_field_classes %>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <%= render Buttons::Component.new(text: "Apply filters", type: "submit", size: :sm) %>
    <%= link_to "Clear filters", url, class: "text-sm underline underline-offset-4" %>
    <p class="text-xs text-neutral-500 dark:text-neutral-400">Dates use Philippine time.</p>
  </div>
<% end %>

<% filter_errors.each do |message| %>
  <%= render Alert::Component.new(title: message, variant: :warning, classes: "mb-4") %>
<% end %>
