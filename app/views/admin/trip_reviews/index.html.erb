<h1 class="text-2xl font-bold">Trip reviews</h1>
<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Read participant feedback. No-show decisions are recorded separately in the incident queue.</p>

<%= render "admin/shared/filters", url: admin_trip_reviews_path, category: :outcome,
           filters: @filters, filter_errors: @filter_errors,
           choices: [["All outcomes", ""], *TripReview.outcomes.keys.map { |outcome| [outcome.humanize, outcome] }] %>

<div class="space-y-4">
  <% @trip_reviews.each do |review| %>
    <article id="<%= dom_id(review) %>" class="rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-700 dark:bg-neutral-900">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h2 class="font-semibold"><%= link_to "Review ##{review.id} · #{review.outcome.humanize}", admin_trip_review_path(review), class: "underline underline-offset-4" %></h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400"><%= admin_timestamp(review.created_at) %></p>
      </div>
      <p class="mt-2 text-sm"><%= admin_route_name(review.ride_post) %> · Trip #<%= review.ride_post_id %></p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">By <%= admin_user_name(review.reporter) %> about <%= admin_user_name(review.reported_user) %></p>
    </article>
  <% end %>
  <% if @trip_reviews.empty? %>
    <p class="rounded-xl border border-neutral-200 p-6 text-sm dark:border-neutral-700">No reviews match these filters.</p>
  <% end %>
</div>
