<div id="chat_message_form" class="p-3 sm:p-4 bg-white dark:bg-neutral-900 border-t border-neutral-100 dark:border-neutral-800">
  <div id="chat_request_feedback"></div>
  <% if ride_post.chat_writable? %>
    <%= form_with(model: [ ride_post, chat_message || ride_post.chat_messages.build ], class: "form-field flex flex-wrap items-center gap-2") do |f| %>
      <%= render Forms::ErrorSummary::Component.new(record: chat_message, form: f,
        title: "Your message wasn’t sent. Check the highlighted fields.") if chat_message %>
      <% body_error = chat_message && form_error(chat_message, :body) %>
      <%= f.label :body, "Coordination message", class: "sr-only" %>
      <%= f.text_field :body,
                       placeholder: "Type a coordination message...",
                       required: true,
                       maxlength: 1000,
                       autocomplete: "off",
                       aria: { label: "Coordination message", invalid: body_error.present? ? "true" : nil, describedby: body_error.present? ? "chat_message_body_error" : nil },
                       data: { chat_scroll_target: "input" },
                       class: "flex-1 min-w-0 px-4 py-2.5 rounded-xl text-base sm:text-sm bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white border border-neutral-200 dark:border-neutral-700 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" %>
      <% if body_error %>
        <p id="chat_message_body_error" class="w-full text-sm text-red-700 dark:text-red-400 order-last"><%= body_error %></p>
      <% end %>
      <button type="submit" class="min-h-11 min-w-11 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white cursor-pointer transition shadow-xs shrink-0">
        <span>Send</span>
        <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M3.105 2.289a.75.75 0 00-.826.95l1.414 4.925A1.5 1.5 0 005.135 9.25h6.115a.75.75 0 010 1.5H5.135a1.5 1.5 0 00-1.442 1.086l-1.414 4.926a.75.75 0 00.826.95 28.896 28.896 0 0015.293-7.154.75.75 0 000-1.115A28.897 28.897 0 003.105 2.289z" />
        </svg>
      </button>
    <% end %>
  <% else %>
    <div class="text-xs text-neutral-500 dark:text-neutral-400 text-center py-2 space-y-1">
      <% if chat_message&.errors&.any? %>
        <div class="text-xs text-red-500 mb-2 w-full text-left">
          <%= safe_join(form_error_entries(chat_message).map { |entry| entry[:error].to_s }, tag.br) %>
        </div>
      <% end %>
      <p class="font-medium text-neutral-700 dark:text-neutral-300">
        <%= ride_post.canceled? ? "Trip canceled & messaging has closed." : "Messaging for this trip has closed." %>
      </p>
      <p>
        Sending new messages is disabled. You can still read chat history until scheduled live-database deletion
        <% if ride_post.chat_history_unavailable_at.present? %>
          on <time datetime="<%= ride_post.chat_history_unavailable_at.iso8601 %>"><%= ride_post.chat_history_unavailable_at.in_time_zone("Asia/Manila").strftime("%B %d, %Y at %I:%M %p") %> Philippine time (UTC+8)</time>
        <% end %>.
      </p>
    </div>
  <% end %>
</div>
