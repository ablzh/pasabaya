<div id="chat_message_form">
  <% if ride_post.chat_writable? %>
    <%= form_with(model: [ ride_post, chat_message || ride_post.chat_messages.build ], class: "flex items-center gap-2") do |f| %>
      <% if chat_message&.errors&.any? %>
        <div class="text-xs text-red-500 mb-2">
          <%= chat_message.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <%= f.text_field :body, placeholder: "Type a coordination message...", required: true, maxlength: 1000, autocomplete: "off", class: "flex-1 px-4 py-2.5 rounded-xl text-sm bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white border border-neutral-200 dark:border-neutral-700 focus:ring-blue-500 focus:border-blue-500" %>
      <%= f.submit "Send", class: "px-4 py-2.5 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white cursor-pointer transition-colors shadow-sm" %>
    <% end %>
  <% else %>
    <p class="text-xs text-neutral-400 italic text-center py-2">
      Trip chat is closed (read-only 24 hours after departure).
    </p>
  <% end %>
</div>
