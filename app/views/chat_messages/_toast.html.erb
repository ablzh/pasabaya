<div data-controller="flash-toasts" class="hidden">
  <div data-flash-toasts-target="item"
       data-type="info"
       data-message="<%= title %>"
       data-description="<%= description %>"
       data-action-label="<%= action_label %>"
       data-action-url="<%= action_url %>"
       data-ride-id="<%= ride_post_id %>">
  </div>
</div>
