<% content_for :title, "#{@ride_schedule.origin&.name || 'Regular'} → #{@ride_schedule.destination&.name || 'Schedule'}" %>

<div class="max-w-4xl mx-auto my-8 px-4 sm:px-6 space-y-8">
  <%# Back Navigation %>
  <div>
    <%= link_to ride_posts_path, class: "text-sm text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 inline-flex items-center gap-1.5 font-medium transition-colors" do %>
      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Board
    <% end %>
  </div>

  <%# Schedule Status Banners %>
  <% if @ride_schedule.draft? %>
    <%= render Alert::Component.new(title: "Private draft", description: "Private draft — confirm the schedule to publish departures.", variant: :warning) %>
  <% elsif @ride_schedule.paused? %>
    <%= render Alert::Component.new(title: "Schedule paused", description: "Schedule paused. Confirmed departures remain scheduled; new requests are closed.", variant: :warning) %>
  <% elsif @ride_schedule.archived? %>
    <%= render Alert::Component.new(title: "Schedule ended", description: "This regular schedule has ended.", variant: :neutral) %>
  <% end %>

  <%# Schedule Header Summary Card %>
  <div class="rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 sm:p-8 space-y-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <%= render Badge::Component.new(text: "Regular Ride", variant: :purple, size: :sm, pill: true) %>
          <% if @ride_schedule.ladies_only? %>
            <%= render Badge::Component.new(text: "Ladies Only", variant: :rose, size: :sm, pill: true) %>
          <% end %>
          <% if @ride_schedule.hub_only? && @ride_schedule.community %>
            <%= render Badge::Component.new(text: "#{@ride_schedule.community.name} Hub", variant: :purple, size: :sm, pill: true) %>
          <% end %>
          <% if @ride_schedule.active? %>
            <%= render Badge::Component.new(text: "Active", variant: :green, size: :sm, pill: true) %>
          <% elsif @ride_schedule.paused? %>
            <%= render Badge::Component.new(text: "Paused", variant: :yellow, size: :sm, pill: true) %>
          <% elsif @ride_schedule.archived? %>
            <%= render Badge::Component.new(text: "Ended", variant: :neutral, size: :sm, pill: true) %>
          <% end %>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
          <%= @ride_schedule.origin&.name || "Choose origin" %> <span class="text-neutral-400 font-normal">&rarr;</span> <%= @ride_schedule.destination&.name || "Choose destination" %>
        </h1>
        <p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">
          Regular ride • <%= @ride_schedule.schedule_display %>
        </p>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          <%= time_tag @ride_schedule.listing_created_at, "Created #{time_ago_in_words(@ride_schedule.listing_created_at)} ago" %>
        </p>
      </div>

      <%# Driver Controls %>
      <% if Current.user&.id == @ride_schedule.user_id %>
        <div class="flex flex-wrap items-center gap-2 sm:self-start">
          <% unless @ride_schedule.archived? %>
            <%= link_to "Edit schedule", edit_ride_schedule_path(@ride_schedule), class: "inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors" %>
          <% end %>
          <% if @ride_schedule.active? %>
            <%= button_to "Pause schedule", pause_ride_schedule_path(@ride_schedule), method: :patch, class: "inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-pointer" %>
          <% elsif @ride_schedule.paused? %>
            <%= button_to "Resume schedule", resume_ride_schedule_path(@ride_schedule), method: :patch, class: "inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-full bg-emerald-600 text-white hover:bg-emerald-700 transition-colors cursor-pointer" %>
          <% end %>
          <% if @ride_schedule.active? || @ride_schedule.paused? %>
            <%= button_to "Cancel all future departures", cancel_future_ride_schedule_path(@ride_schedule), method: :patch, data: { turbo_confirm: "End this schedule and cancel all future departures, including confirmed bookings? Passengers will be notified." }, class: "inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-full text-red-600 hover:bg-red-50 dark:hover:bg-red-950/20 transition-colors cursor-pointer" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Weekday Indicators %>
    <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800 space-y-3">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-semibold text-neutral-500 mr-1.5">Days:</span>
        <% RideSchedule::WEEKDAYS.each do |label, day| %>
          <% is_active_day = @ride_schedule.weekday_ids.include?(day) %>
          <span class="px-2.5 py-1 text-xs font-bold rounded-lg <%= is_active_day ? 'bg-blue-600 text-white shadow-xs' : 'bg-neutral-100 dark:bg-neutral-800/60 text-neutral-400 dark:text-neutral-500' %>">
            <%= label.first(3) %>
          </span>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-neutral-600 dark:text-neutral-400">
        <div>
          <span class="font-semibold text-neutral-900 dark:text-white">Capacity:</span> <%= pluralize(@ride_schedule.seats, "seat") %> per departure
        </div>
        <div>
          <span class="font-semibold text-neutral-900 dark:text-white">Duration:</span> <%= @ride_schedule.end_date ? "Repeats through #{@ride_schedule.end_date.to_fs(:long)}." : "Repeats until paused or ended." %>
        </div>
        <div>All times are Philippine time (UTC+8).</div>
      </div>
      <p class="text-xs text-neutral-500">Each booking is for one departure. Seats are counted separately for every date.</p>
    </div>

    <%# Notes %>
    <% if @ride_schedule.notes.present? %>
      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800">
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1">Driver's Notes</p>
        <p class="text-sm text-neutral-700 dark:text-neutral-300 whitespace-pre-wrap leading-relaxed"><%= @ride_schedule.notes %></p>
      </div>
    <% end %>

    <%# Driver Info %>
    <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800 flex items-center gap-3">
      <%= user_avatar(@ride_schedule.user, classes: "size-9 text-xs shrink-0") %>
      <div>
        <p class="text-sm font-semibold text-neutral-900 dark:text-white leading-tight">
          <%= @ride_schedule.user.first_name %> <%= @ride_schedule.user.last_name %>
        </p>
        <p class="text-xs text-neutral-500">Driver</p>
      </div>
    </div>
  </div>

  <%# Upcoming Departures Agenda Section %>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-neutral-900 dark:text-white">Upcoming departures</h2>
        <p class="text-xs text-neutral-500 mt-0.5">Rolling 14-day booking window. Select any date to view trip details or book a seat.</p>
      </div>
      <% if @departures.any? %>
        <%= render Badge::Component.new(text: pluralize(@departures.count, "date"), variant: :neutral, size: :sm, pill: true) %>
      <% end %>
    </div>

    <% if @departures.empty? %>
      <div class="p-8 text-center text-neutral-500 rounded-2xl border border-dashed border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50">
        <p>No upcoming departures are currently available.</p>
      </div>
    <% else %>
      <%
        today = Date.current
        groups = @departures.group_by do |ride|
          if ride.departure_date <= today.end_of_week
            "This Week"
          elsif ride.departure_date <= (today + 1.week).end_of_week
            "Next Week"
          else
            "Later"
          end
        end
      %>

      <% groups.each do |group_label, group_rides| %>
        <div class="space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-500 px-1"><%= group_label %> (<%= group_rides.count %>)</h3>
          <div class="divide-y divide-neutral-100 dark:divide-neutral-800 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden shadow-xs">
            <% group_rides.each do |ride| %>
              <div id="<%= dom_id ride %>" class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-neutral-50/70 dark:hover:bg-neutral-800/40 transition-colors">
                <div class="flex items-start sm:items-center gap-3.5 min-w-0 flex-1">
                  <%# Calendar Date Badge %>
                  <div class="flex flex-col items-center justify-center size-12 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-center shrink-0 border border-neutral-200/60 dark:border-neutral-700/60">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 leading-tight"><%= ride.departure_date.strftime("%a") %></span>
                    <span class="text-base font-extrabold text-neutral-900 dark:text-white leading-none"><%= ride.departure_date.day %></span>
                  </div>

                  <%# Date & Status Details %>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-semibold text-neutral-900 dark:text-white text-sm">
                        <%= ride.departure_display %>
                      </span>
                      <% if ride.canceled? %>
                        <%= render Badge::Component.new(text: "Cancelled", variant: :red, size: :sm, pill: true) %>
                      <% elsif !ride.bookable? %>
                        <%= render Badge::Component.new(text: "Requests closed", variant: :neutral, size: :sm, pill: true) %>
                      <% end %>
                    </div>

                    <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-0.5">
                      <%= ride.origin.name %> → <%= ride.destination.name %> •
                      <% if ride.canceled? %>
                        Cancelled — this date stays excluded from the schedule.
                      <% elsif ride.remaining_seats.present? %>
                        <span class="font-semibold text-neutral-900 dark:text-white"><%= pluralize(ride.remaining_seats, "seat") %> available</span> on this departure
                      <% else %>
                        <span class="font-semibold text-neutral-900 dark:text-white"><%= pluralize(ride.seats, "seat") %> planned</span>
                      <% end %>
                    </p>

                    <%# Passenger Avatars / Requests for Driver %>
                    <% if Current.user&.id == @ride_schedule.user_id && !ride.canceled? %>
                      <% accepted_passengers = ride.bookings.select(&:accepted?).map(&:passenger) %>
                      <% pending_count = ride.bookings.count(&:pending?) %>
                      <% if accepted_passengers.any? || pending_count.positive? %>
                        <div class="flex flex-wrap items-center gap-2 mt-2">
                          <% if accepted_passengers.any? %>
                            <div class="flex items-center gap-1.5">
                              <div class="flex -space-x-1.5 overflow-hidden">
                                <% accepted_passengers.each do |p| %>
                                  <%= user_avatar(p, classes: "size-5 text-[9px] ring-2 ring-white dark:ring-neutral-900") %>
                                <% end %>
                              </div>
                              <span class="text-[11px] text-neutral-500 font-medium">
                                <%= pluralize(accepted_passengers.size, "passenger") %>
                              </span>
                            </div>
                          <% end %>
                          <% if pending_count.positive? %>
                            <%= render Badge::Component.new(text: "#{pluralize(pending_count, 'request')} pending", variant: :orange, size: :sm, pill: true) %>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>

                    <%# Passenger Booking Badge %>
                    <% if Current.user && Current.user.id != @ride_schedule.user_id %>
                      <% my_booking = ride.bookings.find { |b| b.passenger_id == Current.user.id && b.active? } %>
                      <% if my_booking&.accepted? %>
                        <div class="mt-1.5">
                          <%= render Badge::Component.new(text: "You're booked", variant: :green, size: :sm, pill: true) %>
                        </div>
                      <% elsif my_booking&.pending? %>
                        <div class="mt-1.5">
                          <%= render Badge::Component.new(text: "Booking request pending", variant: :yellow, size: :sm, pill: true) %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <%# Row Actions %>
                <div class="flex flex-wrap items-center gap-2.5 sm:self-center shrink-0">
                  <%= link_to "View departure on #{ride.departure_date.to_fs(:long)}",
                              ride_post_path(ride),
                              class: "inline-flex items-center text-xs font-semibold px-3.5 py-1.5 rounded-full transition-colors #{Current.user&.id != @ride_schedule.user_id && ride.bookable? ? 'bg-blue-600 text-white hover:bg-blue-700 shadow-xs' : 'bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200'}" %>
                  <% if Current.user&.id == @ride_schedule.user_id && !ride.canceled? %>
                    <%= button_to "Cancel this departure",
                                  cancel_ride_post_path(ride),
                                  method: :patch,
                                  data: { turbo_confirm: "Cancel only this departure? Its passengers will be notified." },
                                  class: "text-xs font-semibold text-red-600 hover:text-red-700 dark:text-red-400 hover:underline cursor-pointer" %>
                  <% elsif !ride.bookable? && Current.user&.id != @ride_schedule.user_id %>
                    <span class="text-xs text-neutral-400">Requests closed for this departure.</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
